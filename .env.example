# ──────────────────────────────────────────────────────────────────────
# Meeting Automation — Environment Configuration
# COPY THIS FILE to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-change-this-in-production
APP_BASE_URL=http://localhost:5000

# ── Firebase Auth (Google Sign-In) ───────────────────────────────────
# 1. Go to https://console.firebase.google.com
# 2. Create/select project → Project Settings → Your apps → Add Web app
# 3. Copy the config values below
FIREBASE_API_KEY=AIzaSy_YOUR_KEY_HERE
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:123456789:web:abcdef123456
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# In Firebase Console → Authentication → Sign-in method → Enable "Google"
# Add localhost to Authorized domains

# ── Gmail SMTP (for sending emails) ──────────────────────────────────
# DO NOT use your regular Gmail password. Use an APP PASSWORD:
# 1. myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search "App passwords" → Select Mail → Generate
# 4. Copy the 16-character code (spaces ok)
SMTP_GMAIL_ADDRESS=yourname@gmail.com
SMTP_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Google OAuth (Contacts, Calendar & Gmail read access) ─────────────
# DIFFERENT from Firebase Auth above!
# 1. https://console.cloud.google.com
# 2. APIs & Services → Credentials → Create → OAuth 2.0 Web App
# 3. Authorized Redirect URI: http://localhost:5000/auth/google/callback
# 4. Enable: People API, Calendar API, Gmail API
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret-here

# ── Gemini AI (AI meeting notes + smart translation) ─────────────────
# Free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_KEY

# ── Google Translate API (optional, free MyMemory fallback available) ─
GOOGLE_TRANSLATE_API_KEY=AIzaSy_YOUR_TRANSLATE_KEY
